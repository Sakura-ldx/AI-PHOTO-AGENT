# Copy this file to .env for local development.
# Never commit the real .env file. Environment variables already exported in the
# shell take precedence over values in .env (run_app.py only fills missing ones).

# --- Analysis provider -------------------------------------------------------
# deepseek | openai | codex | mock
AI_PHOTO_AGENT_ANALYSIS_PROVIDER=deepseek

# --- DeepSeek ----------------------------------------------------------------
# Prefer AI_PHOTO_AGENT_DEEPSEEK_API_KEY. DEEPSEEK_API_KEY is accepted as a
# fallback for compatibility with existing shells.
AI_PHOTO_AGENT_DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEY=
AI_PHOTO_AGENT_DEEPSEEK_MODEL=deepseek-flash
AI_PHOTO_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_PHOTO_AGENT_DEEPSEEK_TIMEOUT_SECONDS=180
AI_PHOTO_AGENT_DEEPSEEK_MAX_RETRIES=1
# Optional: read the key from an explicitly configured YAML file. The file must
# contain a line like "DEEPSEEK_API_KEY: sk-...". Leave empty to disable.
AI_PHOTO_AGENT_DEEPSEEK_CREDENTIALS_FILE=

# --- OpenAI ------------------------------------------------------------------
# OPENAI_API_KEY is accepted as a fallback.
AI_PHOTO_AGENT_OPENAI_API_KEY=
# OPENAI_API_KEY=
AI_PHOTO_AGENT_OPENAI_MODEL=gpt-5.6-terra
AI_PHOTO_AGENT_OPENAI_TIMEOUT_SECONDS=45
AI_PHOTO_AGENT_OPENAI_MAX_RETRIES=2

# --- Codex -------------------------------------------------------------------
AI_PHOTO_AGENT_CODEX_MODEL=gpt-5.6-sol
# AI_PHOTO_AGENT_CODEX_EXECUTABLE=C:\path\to\codex.exe
AI_PHOTO_AGENT_CODEX_TIMEOUT_SECONDS=600

# --- Local storage and limits ------------------------------------------------
# Storage root for private state and uploads. The app writes sessions under
# <root>/data/ and uploads under <root>/uploads/. Leave unset to use the
# repository root. Relative paths are resolved from the process working
# directory; %APPDATA% (Windows) and $HOME (POSIX) are expanded.
# AI_PHOTO_AGENT_DATA_DIR=
# AI_PHOTO_AGENT_LIGHTROOM_ROOT=%APPDATA%\Adobe\Lightroom
AI_PHOTO_AGENT_MAX_UPLOAD_BYTES=268435456
AI_PHOTO_AGENT_MAX_IMAGE_PIXELS=50000000

# --- Server ------------------------------------------------------------------
# run_app.py publishes the actual --host/--port value automatically. Set this
# only when you need to force a callback URL.
# AI_PHOTO_AGENT_SERVER_URL=http://127.0.0.1:8000
